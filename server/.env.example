# Copy this file to .env and fill in real values.

# --- Database ---
# SQLite for dev (no setup). Swap to Postgres later by changing the provider
# in prisma/schema.prisma and this URL.
DATABASE_URL="file:./dev.db"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-32-char-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- CORS / Vite origin ---
# The Vite frontend runs on 5173. This is the only origin allowed by middleware.
VITE_ORIGIN="http://localhost:5173"

# --- Bootstrap admin (used by prisma/seed.ts) ---
BOOTSTRAP_ADMIN_USERNAME="aisha"
BOOTSTRAP_ADMIN_EMAIL="aisha@example.com"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123"
BOOTSTRAP_ADMIN_NAME="Aisha Admin"

# --- Email (Resend) ---
# In dev we don't actually send — we just console.log the reset URL.
# Leave blank to keep console.log behavior.
RESEND_API_KEY=""
RESEND_FROM="FOP <noreply@example.com>"

# --- Dev-only toggles ---
# Set to 1 to disable the in-memory rate limiter. Required for the
# test orchestrator (server/tests/_run-all.mjs) so that failed-login
# counters don't leak between sequential tests.
# Set to 0 in production.
RATE_LIMIT_DISABLED="1"

# --- Org branding (used in PDF reports) ---
ORG_NAME="FOP Financial Management System"

# --- Storage cap (F13 storage management) ---
# Total bytes allowed under public/uploads/. Default: 10 GB.
# Per docs/backend/features/13-storage.md gotcha #6, this can be tuned per env.
STORAGE_CAP_BYTES="10737418240"
